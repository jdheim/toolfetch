<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jdheim</groupId>
    <artifactId>toolfetch</artifactId>
    <version>0.0.6-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ToolFetch</name>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://spdx.org/licenses/Apache-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>p-marcin</id>
            <name>Marcin P.</name>
        </developer>
    </developers>

    <properties>
        <!-- Project -->
        <main.class>com.jdheim.toolfetch.Main</main.class>
        <main.class.file>com/jdheim/toolfetch/Main</main.class.file>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.graalvm>${java.version} (${java.vendor} ${java.vm.version})</project.build.graalvm>
        <project.build.outputTimestamp>${git.commit.time}</project.build.outputTimestamp>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Enforce Tools -->
        <enforce-maven.version>3.9.12</enforce-maven.version>
        <enforce-java.version>${maven.compiler.release}</enforce-java.version>

        <!-- Error Prone Compiler Args setup -->
        <compiler.error-prone.args>-Xplugin:ErrorProne -XepOpt:NullAway:AnnotatedPackages=com.jdheim -XepOpt:NullAway:JSpecifyMode=true</compiler.error-prone.args>

        <!-- Maven Surefire/Failsafe Plugin Command Line setup -->
        <argLine/> <!-- @Patch https://github.com/apache/maven-surefire/issues/2260 -->
        <defaultArgLine>
            -Xshare:off
            --enable-native-access=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
        </defaultArgLine>
        <mockitoArgLine> <!-- See https://javadoc.io/doc/org.mockito/mockito-core/latest/org.mockito/org/mockito/Mockito.html#0.3 -->
            -javaagent:${org.mockito:mockito-core:jar}
        </mockitoArgLine>
        <nativeImageArgLine> <!-- @Patch Merge functionality to be implemented or replaced by native-agent-scan-with-maven -->
            -agentlib:native-image-agent=access-filter-file=${maven.multiModuleProjectDirectory}/test/toolfetch-native-agent/src/main/resources/native-access-filter.json,config-merge-dir=${maven.multiModuleProjectDirectory}/test/toolfetch-native-agent/target/classes
        </nativeImageArgLine>

        <!-- GraalVM JDK: also update in jreleaser.yml -->
        <graalvm-jdk.version>25.0.3</graalvm-jdk.version>
        <!-- curl -s https://download.oracle.com/graalvm/25/archive/graalvm-jdk-25.0.3_linux-x64_bin.tar.gz.sha256 -->
        <graalvm-jdk.sha256.linux-amd64>1b5296613c3d12521d594e1c99302df88d8e1f07d74ab7983dbf572000b92c7c</graalvm-jdk.sha256.linux-amd64>
        <!-- curl -s https://download.oracle.com/graalvm/25/archive/graalvm-jdk-25.0.3_linux-aarch64_bin.tar.gz.sha256 -->
        <graalvm-jdk.sha256.linux-arm64>2c6e5ef63084c5f39c67cbf5c33d23c852df848d10cd50d76e667fff9c9cf2bc</graalvm-jdk.sha256.linux-arm64>

        <!-- GitHub Actions -->
        <syft.version>1.45.0</syft.version>
        <syft.sha256.linux-amd64>cd5efa489e93ecde99c03a218db5dee8b3f03610466d7565cefd735610d1b28b</syft.sha256.linux-amd64>
        <syft.sha256.linux-arm64>3101fc588a6662ab3d46eda470159f82d6c6c0fd59f618fdd29928ed1c1197bb</syft.sha256.linux-arm64>
        <upx.version>5.1.1</upx.version>
        <upx.sha256.linux-amd64>1ff660454227861e00772f743f66b900072116b9dc24f6ee28b97cce88a7828a</upx.sha256.linux-amd64>
        <upx.sha256.linux-arm64>a307c2c821eeab47607ba5c232408b22ab884cca13884682508b98f7308b8443</upx.sha256.linux-arm64>

        <!-- Plugins -->
        <dependency-check-maven.version>12.2.2</dependency-check-maven.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>
        <git-commit-id-maven-plugin.version>10.0.0</git-commit-id-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <jdks-maven-plugin.version>1.25.0</jdks-maven-plugin.version>
        <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <native-maven-plugin.version>1.1.1</native-maven-plugin.version>
        <properties-maven-plugin.version>1.3.0</properties-maven-plugin.version>
        <sonar-maven-plugin.version>5.7.0.6970</sonar-maven-plugin.version>
        <spotbugs-maven-plugin.version>4.9.8.3</spotbugs-maven-plugin.version>
        <spotbugs-plugin.version>4.9.8</spotbugs-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jdheim</groupId>
                <artifactId>toolfetch-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs</artifactId>
                <version>${spotbugs-plugin.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs-plugin.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>com.google.code.findbugs</groupId>
                        <artifactId>jsr305</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.h3xstream.findsecbugs</groupId>
                <artifactId>findsecbugs-plugin</artifactId>
                <version>${findsecbugs-plugin.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>com.github.spotbugs</groupId>
                            <artifactId>spotbugs</artifactId>
                            <version>${spotbugs-plugin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>${git-commit-id-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <failOnWarning>true</failOnWarning>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                            </path>
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <!-- ErrorProne -->
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <arg>${compiler.error-prone.args}</arg>
                            <!-- @Patch Necessary only if building with JDK21+: https://github.com/google/error-prone/issues/5426 -->
                            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                    <configuration>
                        <ignoredUnusedDeclaredDependencies>
                            <ignoredUnusedDeclaredDependency>ch.qos.logback:logback-classic</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>ch.qos.logback:logback-core</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>com.github.luben:zstd-jni</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>com.github.spotbugs:spotbugs-annotations</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>org.brotli:dec</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>org.fusesource.jansi:jansi</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>org.jspecify:jspecify</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>org.tukaani:xz</ignoredUnusedDeclaredDependency>

                            <ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit5</ignoredUnusedDeclaredDependency>
                            <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
                        </ignoredUnusedDeclaredDependencies>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                            <include>**/*SmokeTest.java</include>
                        </includes>
                        <systemPropertyVariables>
                            <org.fusesource.jansi.Ansi.disable>true</org.fusesource.jansi.Ansi.disable>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                    <configuration>
                        <propertiesEncoding>ISO-8859-1</propertiesEncoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                            <exclude>**/*SmokeTest.java</exclude>
                        </excludes>
                        <systemPropertyVariables>
                            <org.fusesource.jansi.Ansi.disable>true</org.fusesource.jansi.Ansi.disable>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>properties-maven-plugin</artifactId>
                    <version>${properties-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native-maven-plugin.version}</version>
                    <configuration>
                        <mainClass>${main.class}</mainClass>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>${main.class.file}.class</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jreleaser</groupId>
                    <artifactId>jdks-maven-plugin</artifactId>
                    <version>${jdks-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check-maven.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${enforce-maven.version}</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>${enforce-java.version}</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                                <requireUpperBoundDeps/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>bom/toolfetch-bom</module>

        <module>src/toolfetch-models</module>
        <module>src/toolfetch-services</module>
        <module>src/toolfetch-commands</module>
    </modules>

    <profiles>
        <profile>
            <id>native-agent-scan</id>
            <modules>
                <module>test/toolfetch-native-agent</module>
            </modules>
        </profile>
        <profile>
            <id>tests</id>
            <activation>
                <property>
                    <name>!skipAllTests</name>
                </property>
            </activation>
            <modules>
                <module>test/toolfetch-test-steps</module>
                <module>test/toolfetch-unit-tests</module>
                <module>test/toolfetch-integration-tests</module>
                <module>test/toolfetch-smoke-tests</module>
                <module>test/toolfetch-test-coverage</module>
            </modules>
        </profile>
        <profile>
            <id>native-image</id>
            <modules>
                <module>build/toolfetch-native-image</module>
            </modules>
        </profile>
        <profile>
            <id>linux-amd64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <graalvm.platform>linux-amd64</graalvm.platform>
            </properties>
        </profile>
        <profile>
            <id>linux-arm64</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <graalvm.platform>linux-arm64</graalvm.platform>
            </properties>
        </profile>
        <profile>
            <id>setup-graalvm</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>clean-graalvm-jdk</id>
                                <inherited>false</inherited>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.directory}/jdks"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jdks-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>setup-graalvm-jdk</id>
                                <inherited>false</inherited>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>setup-jdks</goal>
                                </goals>
                                <configuration>
                                    <selectCurrentPlatform>true</selectCurrentPlatform>
                                    <jdks>
                                        <jdk>
                                            <name>graalvm-linux-amd64</name>
                                            <platform>linux-x86_64</platform>
                                            <url>https://download.oracle.com/graalvm/${maven.compiler.release}/archive/graalvm-jdk-${graalvm-jdk.version}_linux-x64_bin.tar.gz</url>
                                            <checksum>${graalvm-jdk.sha256.linux-amd64}</checksum>
                                        </jdk>
                                        <jdk>
                                            <name>graalvm-linux-arm64</name>
                                            <platform>linux-aarch64</platform>
                                            <url>https://download.oracle.com/graalvm/${maven.compiler.release}/archive/graalvm-jdk-${graalvm-jdk.version}_linux-aarch64_bin.tar.gz</url>
                                            <checksum>${graalvm-jdk.sha256.linux-arm64}</checksum>
                                        </jdk>
                                    </jdks>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>rename-graalvm-jdk</id>
                                <inherited>false</inherited>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>
                                            <![CDATA[
                                                mv ${project.build.directory}/jdks/graalvm-${graalvm.platform}/graalvm-jdk-${graalvm-jdk.version}+* \
                                                    ${project.build.directory}/jdks/graalvm-${graalvm.platform}/graalvm-jdk-${graalvm-jdk.version}
                                            ]]>
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>detect-graalvm-version</id>
                                <inherited>false</inherited>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>
                                            <![CDATA[
                                                GRAALVM_JDK="${project.build.directory}/jdks/graalvm-${graalvm.platform}/graalvm-jdk-${graalvm-jdk.version}/bin/java"
                                                "$GRAALVM_JDK" -XshowSettings:properties -version 2>&1 | awk -F'= ' '
                                                    /java.version =/    { java_version=$2 }
                                                    /java.vendor =/     { java_vendor=$2 }
                                                    /java.vm.version =/ { java_vm_version=$2 }
                                                    END {
                                                        printf "project.build.graalvm=%s (%s %s)\n", java_version, java_vendor, java_vm_version
                                                    }
                                                ' > "${project.build.directory}/jdks/graalvm-${graalvm.platform}/graalvm-version.properties"]]>
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>owasp-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <executions>
                            <execution>
                                <id>aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                            <failBuildOnCVSS>0</failBuildOnCVSS>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>spotbugs-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold> <!-- @Patch Set to Low -->
                            <htmlOutput>true</htmlOutput>
                            <includeTests>true</includeTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
