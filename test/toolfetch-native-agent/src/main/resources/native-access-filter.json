{
  "rules": [
    {
      "includeClasses": "**"
    },
    {
      "excludeClasses": "com.tngtech.**"
    },
    {
      "excludeClasses": "org.assertj.**"
    },
    {
      "excludeClasses": "org.junit.**"
    },
    {
      "excludeClasses": "org.mockito.**"
    },
    {
      "excludeClasses": "org.wiremock.**"
    },
    {
      "excludeClasses": "com.github.tomakehurst.**"
    },
    {
      "excludeClasses": "com.fasterxml.jackson.databind.**"
    },
    {
      "excludeClasses": "com.jayway.**"
    },
    {
      "excludeClasses": "org.apiguardian.**"
    },
    {
      "excludeClasses": "org.eclipse.jetty.**"
    },
    {
      "excludeClasses": "org.opentest4j.**"
    },
    {
      "excludeClasses": "net.bytebuddy.**"
    },
    {
      "excludeClasses": "java.**"
    },
    {
      "excludeClasses": "jdk.**"
    },
    {
      "excludeClasses": "groovy.**"
    },
    {
      "excludeClasses": "kotlin.**"
    },
    {
      "excludeClasses": "scala.**"
