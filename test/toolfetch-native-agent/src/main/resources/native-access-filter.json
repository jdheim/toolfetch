    },
    {
      "excludeClasses": "sun.**"
    },
    {
      "excludeClasses": "org.apache.maven.**"
    }
  ],
  "regexRules": [
    {
      "includeClasses": ".*"
    },
    {
      "excludeClasses": "^com\\.jdheim\\.toolfetch\\.(?:.*(?:TestBase|Test|IT)|.*\\.Test.*)(?:\\$.*)?$"
    },
    {
      "excludeClasses": "^com\\.tngtech\\..*(?:\\[\\])+$"
    },
    {
      "excludeClasses": "^(?:java\\..*(?:\\[\\])+|\\[+Ljava\\..*;)$"
    },
    {
      "excludeClasses": "^.*\\$MockitoMock\\$.*$"
    }
  ]
}
