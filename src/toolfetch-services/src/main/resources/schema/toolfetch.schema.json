{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jdheim.com/schema/toolfetch.schema.json",
  "title": "ToolFetch",
  "description": "CLI for fetching and installing external tools from release URLs (e.g. GitHub releases) using a YAML configuration file",
  "type": "object",
  "required": [
    "destination",
    "tools"
  ],
  "properties": {
    "destination": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "http": {
      "type": "object",
      "properties": {
        "connectTimeout": {
          "type": "integer",
          "description": "HTTP connect timeout in seconds. Default: 10 seconds",
          "minimum": 10,
          "maximum": 300
        },
        "requestTimeout": {
          "type": "integer",
          "description": "HTTP request timeout in seconds. Default: 900 seconds (15 minutes)",
          "minimum": 10,
          "maximum": 86400
        },
        "ssl": {
          "type": "object",
          "properties": {
            "trustStore": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Location of the TrustStore file containing trusted CA certificates. Default: $JAVA_HOME/lib/security/cacerts, $JAVA_HOME/jre/lib/security/cacerts or the bundled default TrustStore",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                },
                "type": {
                  "type": "string",
                  "description": "TrustStore type. Default: autodetected. Set the type if autodetection fails",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "url": {
            "type": "string",
            "description": "URL must start with 'http://' or 'https://'. It may contain the ${version} placeholder; no other ${...} placeholders are allowed",
            "minLength": 1,
            "allOf": [
              {
                "pattern": "^\\S+$"
              },
              {
                "pattern": "^https?://(?:(?!\\$\\{(?!version\\})).)*$"
              }
            ]
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "checksums": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "sha384": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{96}$"
              },
              "sha512": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{128}$"
              }
            },
            "anyOf": [
              {
                "required": [
                  "sha256"
                ]
              },
              {
                "required": [
                  "sha384"
                ]
              },
              {
                "required": [
                  "sha512"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "url": {
                  "pattern": "\\$\\{version\\}"
                }
              }
            },
            "then": {
              "required": [
                "version"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "version"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
